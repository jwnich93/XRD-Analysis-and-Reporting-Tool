# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://xrd_user:xrd_pass@localhost:5432/xrd_db

# Cloud SQL (production) — use the Cloud SQL Auth Proxy socket path
# DATABASE_URL=postgresql+asyncpg://xrd_user:PASSWORD@/xrd_db?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
CLOUD_SQL_INSTANCE=your-gcp-project-id:us-central1:xrd-postgres

# ── API ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://your-frontend-url.run.app
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Frontend (Vite build-time) ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
